# Large source scans — kept locally, not committed.
# Their provenance (title/URL/licence) is recorded in research/notes/source-note.md,
# and the transcribed rows in sources/processed/records.json.
sources/raw/*.jpg
sources/raw/*.jpeg
sources/raw/*.png
sources/raw/*.tif
sources/raw/*.tiff

# Large generated or local-only artifacts
artifacts/**
!artifacts/
!artifacts/README.md

# Local databases
*.sqlite
*.sqlite3
*.db
*.duckdb

# Python/Notebook noise
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# OS/editor noise
.DS_Store
.vscode/
.idea/
